VITE_API_URL=http://localhost:4000

# Precisa ser IGUAL à API_KEY configurada no backend/.env — o backend
# recusa (401) qualquer pedido que não mande essa chave no cabeçalho
# x-api-key. Como o Vite embute esse valor no JavaScript final na hora do
# build, ele fica visível pra quem abrir o DevTools do navegador: essa
# chave barra acesso oportunista de fora, não substitui um login de verdade.
VITE_API_KEY=
