# Copie este arquivo pra ".env" e preencha com os valores reais.
# ".env" nunca é commitado (veja .gitignore) — cada pessoa/máquina tem o seu.

# Chave secreta que o frontend precisa mandar em todo pedido (cabeçalho
# x-api-key) pra provar que tem permissão de usar a API — sem ela,
# /carregamentos e /checkins recusam o pedido com 401. Gere um valor
# aleatório longo (ex: "openssl rand -hex 32"), nunca um valor óbvio. Tem
# que ser IGUAL ao VITE_API_KEY configurado no frontend/.env.
API_KEY=

# Endereço(s) do frontend autorizados a chamar essa API (separados por
# vírgula, sem espaço). Em produção, aponte pro domínio real do frontend
# em vez do localhost.
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# SQL Server da empresa (dbo.vfluxo — só leitura, nunca escrevemos aqui).
DB_USER=
DB_PASSWORD=
DB_SERVER=
DB_DATABASE=
DB_PORT=1433
DB_ENCRYPT=false

# Banco de check-ins, dedicado e nosso (veja database/checkins-schema.sql
# pra criar o banco antes de preencher estas variáveis).
CHECKINS_DB_USER=
CHECKINS_DB_PASSWORD=
CHECKINS_DB_SERVER=
CHECKINS_DB_DATABASE=Checkins
CHECKINS_DB_PORT=1433
CHECKINS_DB_ENCRYPT=false
